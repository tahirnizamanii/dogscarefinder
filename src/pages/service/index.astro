---
// src/pages/service/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchAllRecords, slugify } from "../../lib/database.js";
import { breadcrumbSchema, webPageSchema, itemListSchema, faqSchema } from "../../lib/schemas.js";

const listings = await fetchAllRecords();

const CATEGORY_ICONS = {
  Groomers: "fa-scissors",
  Trainers: "fa-bullseye",
  Boarding: "fa-house",
  Vets: "fa-stethoscope",
  Therapy: "fa-paw",
};

const CATEGORY_DESCRIPTIONS = {
  Groomers: "Bathing, trimming, styling, de-shedding, and coat care for dogs of all breeds and sizes.",
  Trainers: "Obedience, behavior modification, puppy training, and advanced command classes.",
  Boarding: "Kennels, dog daycare, overnight stays, and long-term boarding facilities.",
  Vets: "Wellness exams, vaccinations, surgery, dental care, and emergency veterinary services.",
  Therapy: "Emotional support, hospital visits, therapeutic services, and certified therapy dog programs.",
};

const CATEGORY_IMAGES = {
  Groomers: "https://images.unsplash.com/photo-1583337130417-3346a1be7dee?w=1000&q=80&auto=format&fit=crop",
  Trainers: "https://images.unsplash.com/photo-1601758228041-f3b2795255f1?w=1000&q=80&auto=format&fit=crop",
  Boarding: "https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=1000&q=80&auto=format&fit=crop",
  Vets: "https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=1000&q=80&auto=format&fit=crop",
  Therapy: "https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=1000&q=80&auto=format&fit=crop",
};

const categoryMap = new Map();
for (const l of listings) {
  if (!l.category) continue;
  const cat = l.category;
  if (!categoryMap.has(cat)) {
    categoryMap.set(cat, {
      name: cat,
      slug: slugify(cat),
      count: 0,
      states: new Set(),
      cities: new Set(),
    });
  }
  const entry = categoryMap.get(cat);
  entry.count++;
  if (l.state) entry.states.add(l.state);
  if (l.city) entry.cities.add(l.city);
}

const categories = Array.from(categoryMap.values())
  .map((c) => ({
    ...c,
    stateCount: c.states.size,
    cityCount: c.cities.size,
    states: Array.from(c.states).sort(),
  }))
  .sort((a, b) => b.count - a.count);

const totalListings = listings.length;
const totalStates = new Set(listings.map((l) => l.state)).size;
const totalCities = new Set(listings.map((l) => `${l.state}::${l.city}`)).size;

const title = "Browse All Dog Care Services — Every Category, Every State | DogCareFinder";
const description = `Explore ${categories.length} dog care categories across ${totalStates} states and ${totalCities} cities. Find groomers, trainers, boarding, vets, and therapy dogs near you.`;
const canonical = "https://dogcarefinder.com/service/";

const faqs = [
  {
    question: "How many dog care categories do you list?",
    answer: `We list ${categories.length} main categories: ${categories.map((c) => c.name).join(", ")}. Each category covers the full range of services within it.`,
  },
  {
    question: "Can I list my business in multiple categories?",
    answer: "We recommend choosing your primary service for the best user experience. Contact us if you offer significantly different services.",
  },
  {
    question: "Is browsing free?",
    answer: "Yes — 100% free. No referral fees, no booking commissions, no account required.",
  },
  {
    question: "How do I find services in my state?",
    answer: "Click any category below, then select your state or city to see local providers with verified contact information.",
  },
];

const schemas = [
  webPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: "Home", url: "https://dogcarefinder.com/" },
    { name: "Services", url: canonical },
  ]),
  itemListSchema(
    "Dog Care Service Categories",
    description,
    canonical,
    categories.map((c) => ({
      businessName: c.name,
      city: "",
      state: "",
      category: c.name,
      phone: "",
      website: `https://dogcarefinder.com/service/${c.slug}/`,
      streetAddress: "",
      zipCode: "",
      rating: null,
      reviewCount: c.count,
    })),
    "Directory"
  ),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>

  <!-- ═══════════ HERO ═══════════ -->
  <section class="bg-navy-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
      <nav class="text-xs text-white/70 flex items-center gap-2 mb-4">
        <a href="/" class="hover:text-white transition">Home</a>
        <i class="fa-solid fa-chevron-right text-[9px]"></i>
        <span class="text-white font-semibold">Services</span>
      </nav>
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur border border-white/20 rounded-full px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest text-white/90 mb-5">
        <i class="fa-solid fa-layer-group text-gold-400"></i>
        All Categories
      </div>
      <h1 class="font-serif text-4xl lg:text-5xl font-bold leading-tight">
        Browse All Services
      </h1>
      <p class="mt-4 text-white/80 max-w-2xl">
        Explore every category of dog care across the United States — from groomers to emergency vets.
      </p>
      <div class="mt-8 grid grid-cols-3 sm:flex sm:items-center gap-6 text-sm text-white/80 max-w-lg">
        <div>
          <div class="text-2xl lg:text-3xl font-bold text-white">{totalListings}</div>
          <div class="text-[11px] uppercase tracking-widest text-white/60">Providers</div>
        </div>
        <div class="hidden sm:block w-px h-10 bg-white/20"></div>
        <div>
          <div class="text-2xl lg:text-3xl font-bold text-white">{totalStates}</div>
          <div class="text-[11px] uppercase tracking-widest text-white/60">States</div>
        </div>
        <div class="hidden sm:block w-px h-10 bg-white/20"></div>
        <div>
          <div class="text-2xl lg:text-3xl font-bold text-white">{totalCities}</div>
          <div class="text-[11px] uppercase tracking-widest text-white/60">Cities</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ CATEGORY GRID ═══════════ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      {categories.map((cat) => (
        <article class="group bg-white border border-slate-200 rounded-2xl overflow-hidden hover:border-forest-400 hover:shadow-xl transition-all duration-300 flex flex-col">

          <!-- Cover Image -->
          <a href={`/service/${cat.slug}/`} class="block relative h-52 overflow-hidden">
            <img
              src={CATEGORY_IMAGES[cat.name] || "https://images.unsplash.com/photo-1601758228041-f3b2795255f1?w=1000&q=80&auto=format&fit=crop"}
              alt={`Dog ${cat.name.toLowerCase()} — ${CATEGORY_DESCRIPTIONS[cat.name]}`}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              loading="lazy"
              width="1000"
              height="600"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/85 via-navy-900/20 to-transparent"></div>

            <!-- Icon badge -->
            <div class="absolute top-4 left-4 w-12 h-12 bg-white rounded-xl flex items-center justify-center text-forest-600 text-lg shadow-lg group-hover:scale-110 transition-transform">
              <i class={`fa-solid ${CATEGORY_ICONS[cat.name] || "fa-paw"}`}></i>
            </div>

            <!-- Count badge -->
            <div class="absolute top-4 right-4 bg-forest-600 text-white text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full shadow-md">
              {cat.count} {cat.count === 1 ? "provider" : "providers"}
            </div>

            <!-- Title over image -->
            <div class="absolute bottom-4 left-5 right-5 text-white">
              <h2 class="font-serif text-2xl font-bold drop-shadow-lg">
                Dog {cat.name}
              </h2>
            </div>
          </a>

          <!-- Body -->
          <div class="p-6 flex-1 flex flex-col">
            <p class="text-sm text-slate-600 leading-relaxed flex-1">
              {CATEGORY_DESCRIPTIONS[cat.name]}
            </p>

            <!-- Meta row -->
            <div class="mt-4 flex items-center gap-4 text-xs text-slate-500">
              <span class="inline-flex items-center gap-1.5">
                <i class="fa-solid fa-map-location-dot text-forest-600"></i>
                <span class="font-semibold text-navy-900">{cat.stateCount}</span>
                {cat.stateCount === 1 ? "state" : "states"}
              </span>
              <span class="inline-flex items-center gap-1.5">
                <i class="fa-solid fa-city text-forest-600"></i>
                <span class="font-semibold text-navy-900">{cat.cityCount}</span>
                {cat.cityCount === 1 ? "city" : "cities"}
              </span>
            </div>

            <!-- State chips -->
            {cat.states.length > 0 && (
              <div class="mt-4 pt-4 border-t border-slate-100">
                <div class="flex flex-wrap items-center gap-1.5">
                  {cat.states.slice(0, 5).map((st) => (
                    <a
                      href={`/${st.toLowerCase()}/${cat.slug}/`}
                      class="inline-block bg-slate-50 hover:bg-forest-50 border border-slate-200 hover:border-forest-300 rounded text-[10px] font-bold uppercase tracking-wider text-slate-600 hover:text-forest-700 px-2 py-1 transition"
                    >
                      {st}
                    </a>
                  ))}
                  {cat.states.length > 5 && (
                    <span class="text-[10px] font-semibold text-slate-400">
                      +{cat.states.length - 5} more
                    </span>
                  )}
                </div>
              </div>
            )}

            <!-- CTA -->
            <a
              href={`/service/${cat.slug}/`}
              class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-forest-600 hover:text-forest-700 transition group-hover:gap-3"
            >
              Browse all {cat.name.toLowerCase()}
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ═══════════ CTA BAND ═══════════ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <div class="bg-gradient-to-br from-forest-600 to-navy-900 rounded-2xl p-8 lg:p-12 text-center text-white relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_right,_var(--tw-gradient-stops))] from-gold-400/20 via-transparent to-transparent"></div>
      <div class="relative">
        <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur border border-white/20 rounded-full px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest mb-5">
          <i class="fa-solid fa-store text-gold-400"></i>
          Grow Your Business
        </div>
        <h2 class="font-serif text-3xl lg:text-4xl font-bold mb-4">
          Own a dog care business?
        </h2>
        <p class="text-white/85 max-w-xl mx-auto mb-8">
          List your service and get found by dog owners searching your state and city. Free listing available — no commissions.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/submit-listing/" class="bg-gold-400 hover:bg-gold-500 text-navy-900 font-bold px-8 py-3.5 rounded-lg transition inline-flex items-center justify-center gap-2">
            <i class="fa-solid fa-plus-circle"></i>
            List Your Business
          </a>
          <a href="/list-your-business/" class="bg-white/10 hover:bg-white/20 border border-white/25 text-white font-semibold px-8 py-3.5 rounded-lg transition inline-flex items-center justify-center gap-2">
            <i class="fa-solid fa-tag"></i>
            See Pricing Plans
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ FAQ ═══════════ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="font-serif text-2xl sm:text-3xl font-bold text-navy-900 text-center mb-2">
      Common Questions
    </h2>
    <p class="text-center text-sm text-slate-500 mb-8">
      Everything you need to know about browsing our directory.
    </p>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="group bg-white border border-slate-200 rounded-xl">
          <summary class="cursor-pointer flex items-center justify-between gap-4 p-5 font-semibold text-navy-900 hover:bg-cream-50 transition rounded-xl">
            {faq.question}
            <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
          </summary>
          <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed">{faq.answer}</div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>