---
// src/pages/admin/submissions.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import { breadcrumbSchema, webPageSchema } from "../../lib/schemas.js";

const title = "Admin — Submissions | DogCareFinder";
const description = "Moderate listing submissions.";
const canonical = "https://dogscarefinder.com/admin/submissions/";
const API = import.meta.env.PUBLIC_API_BASE_URL || "";

const schemas = [
  webPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: "Home", url: "https://dogscarefinder.com/" },
    { name: "Admin", url: canonical },
  ]),
];
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Loading state -->
    <div id="loading" class="text-center py-16">
      <i class="fa-solid fa-spinner fa-spin text-3xl text-forest-600"></i>
      <p class="mt-4 text-slate-500">Loading admin panel...</p>
    </div>

    <!-- Unauthorized state -->
    <div id="unauthorized" class="hidden max-w-md mx-auto bg-white border border-slate-200 rounded-2xl p-8 text-center">
      <div class="w-16 h-16 mx-auto bg-red-50 rounded-full flex items-center justify-center text-red-500 text-3xl mb-5">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <h1 class="font-serif text-2xl font-bold text-navy-900 mb-3">Admin Access Required</h1>
      <p class="text-slate-600 mb-6 text-sm">You must be logged in as an admin to view this page.</p>
      <a href="/login/" class="bg-forest-600 hover:bg-forest-700 text-white font-semibold px-5 py-2.5 rounded-lg transition text-sm">
        <i class="fa-solid fa-right-to-bracket mr-1"></i> Log In
      </a>
    </div>

    <!-- Admin panel -->
    <div id="admin-panel" class="hidden">

      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
          <nav class="text-xs text-slate-500 flex gap-2 mb-2">
            <a href="/" class="hover:text-forest-600">Home</a>
            <i class="fa-solid fa-chevron-right text-[9px] self-center"></i>
            <a href="/admin/" class="hover:text-forest-600">Admin</a>
            <i class="fa-solid fa-chevron-right text-[9px] self-center"></i>
            <span class="text-navy-900 font-semibold">Submissions</span>
          </nav>
          <h1 class="font-serif text-3xl font-bold text-navy-900">Moderation Queue</h1>
          <p class="text-sm text-slate-500 mt-1">Review, approve, or reject listing submissions from users.</p>
        </div>
        <a href="/admin/" class="text-sm font-semibold text-forest-600 hover:text-forest-700 inline-flex items-center gap-2">
          <i class="fa-solid fa-arrow-left"></i>
          Back to Admin
        </a>
      </div>

      <!-- Status tabs -->
      <div class="flex flex-wrap gap-2 mb-6">
        <button data-status="pending" class="status-tab bg-forest-600 text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition">
          <i class="fa-solid fa-clock mr-1.5"></i>
          Pending
          <span id="count-pending" class="bg-white/20 rounded-full px-2 py-0.5 ml-1 text-xs">0</span>
        </button>
        <button data-status="approved" class="status-tab bg-white border border-slate-200 text-navy-900 px-5 py-2.5 rounded-lg font-semibold text-sm transition hover:border-forest-400">
          <i class="fa-solid fa-check mr-1.5"></i>
          Approved
        </button>
        <button data-status="rejected" class="status-tab bg-white border border-slate-200 text-navy-900 px-5 py-2.5 rounded-lg font-semibold text-sm transition hover:border-forest-400">
          <i class="fa-solid fa-xmark mr-1.5"></i>
          Rejected
        </button>
      </div>

      <!-- Submissions list -->
      <div id="submissions" class="space-y-4"></div>

    </div>
  </section>

  <script is:inline define:vars={{ API }}>
    (function () {
      var loading = document.getElementById("loading");
      var unauthorized = document.getElementById("unauthorized");
      var adminPanel = document.getElementById("admin-panel");
      var container = document.getElementById("submissions");
      var currentStatus = "pending";

      function show(el) {
        loading.classList.add("hidden");
        unauthorized.classList.add("hidden");
        adminPanel.classList.add("hidden");
        el.classList.remove("hidden");
      }

      function escapeHtml(s) {
        return String(s || "").replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }

      function formatDate(ts) {
        return new Date(Number(ts)).toLocaleDateString("en-US", {
          year: "numeric", month: "short", day: "numeric",
        });
      }

      async function loadSubmissions(status) {
        currentStatus = status;

        // Update tab styling
        document.querySelectorAll(".status-tab").forEach(function (btn) {
          if (btn.getAttribute("data-status") === status) {
            btn.className = "status-tab bg-forest-600 text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition";
          } else {
            btn.className = "status-tab bg-white border border-slate-200 text-navy-900 px-5 py-2.5 rounded-lg font-semibold text-sm transition hover:border-forest-400";
          }
        });

        container.innerHTML = '<div class="text-center py-12"><i class="fa-solid fa-spinner fa-spin text-2xl text-forest-600"></i></div>';

        try {
          var res = await fetch(API + "/api/admin/submissions?status=" + status, {
            credentials: "include",
          });
          var data = await res.json();

          if (!res.ok) {
            if (res.status === 403) return show(unauthorized);
            throw new Error(data.error || "Failed to load");
          }

          var list = data.submissions || [];

          // Update pending count (only when loading pending tab)
          if (status === "pending") {
            document.getElementById("count-pending").textContent = list.length;
          }

          if (list.length === 0) {
            container.innerHTML = '<div class="bg-white border border-slate-200 rounded-xl p-12 text-center"><i class="fa-solid fa-inbox text-4xl text-slate-300 mb-3"></i><p class="text-slate-500">No ' + status + ' submissions.</p></div>';
            return;
          }

          container.innerHTML = list.map(function (s) {
            var statusColors = {
              pending: "bg-amber-50 text-amber-700 border-amber-200",
              approved: "bg-emerald-50 text-emerald-700 border-emerald-200",
              rejected: "bg-red-50 text-red-700 border-red-200",
            };
            var statusColor = statusColors[s.status] || "bg-slate-100 text-slate-600 border-slate-200";

            var actions = "";
            if (status === "pending") {
              actions = '<div class="flex flex-wrap gap-2 mt-5 pt-5 border-t border-slate-100">'
                + '<button data-id="' + s.id + '" data-action="approve" class="action-btn bg-forest-600 hover:bg-forest-700 text-white text-sm font-bold px-5 py-2.5 rounded-lg transition inline-flex items-center gap-2">'
                + '<i class="fa-solid fa-check"></i> Approve & Publish'
                + '</button>'
                + '<button data-id="' + s.id + '" data-action="reject" class="action-btn bg-red-500 hover:bg-red-600 text-white text-sm font-bold px-5 py-2.5 rounded-lg transition inline-flex items-center gap-2">'
                + '<i class="fa-solid fa-xmark"></i> Reject'
                + '</button>'
                + '</div>';
            }

            return '<article class="bg-white border border-slate-200 rounded-xl p-6">'
              + '<div class="flex flex-wrap items-start justify-between gap-3 mb-4">'
              + '<div class="flex-1 min-w-0">'
              + '<h3 class="font-bold text-navy-900 text-xl leading-tight">' + escapeHtml(s.business_name) + '</h3>'
              + '<div class="flex flex-wrap items-center gap-2 mt-2">'
              + '<span class="inline-flex items-center gap-1.5 bg-forest-50 text-forest-700 text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded">'
              + '<i class="fa-solid fa-tag text-[10px]"></i>'
              + escapeHtml(s.category)
              + '</span>'
              + '<span class="inline-flex items-center gap-1.5 bg-slate-100 text-slate-600 text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded">'
              + '<i class="fa-solid fa-map-pin text-[10px]"></i>'
              + escapeHtml(s.city) + ', ' + escapeHtml(s.state)
              + '</span>'
              + '</div>'
              + '</div>'
              + '<span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full border ' + statusColor + '">'
              + escapeHtml(s.status)
              + '</span>'
              + '</div>'

              + '<div class="grid sm:grid-cols-2 gap-x-6 gap-y-3 text-sm text-slate-600">'
              + '<div class="flex items-start gap-2"><i class="fa-solid fa-location-dot text-forest-600 w-4 mt-0.5"></i>'
              + '<span>' + escapeHtml(s.street_address || "—") + (s.zip_code ? ', ' + escapeHtml(s.zip_code) : "") + '</span>'
              + '</div>'
              + '<div class="flex items-start gap-2"><i class="fa-solid fa-phone text-forest-600 w-4 mt-0.5"></i>'
              + '<span>' + escapeHtml(s.phone || "—") + '</span>'
              + '</div>'
              + '<div class="flex items-start gap-2"><i class="fa-solid fa-globe text-forest-600 w-4 mt-0.5"></i>'
              + '<span>' + (s.website ? '<a href="' + escapeHtml(s.website) + '" target="_blank" rel="noopener" class="text-forest-600 underline break-all">' + escapeHtml(s.website) + '</a>' : "—") + '</span>'
              + '</div>'
              + '<div class="flex items-start gap-2"><i class="fa-solid fa-user text-forest-600 w-4 mt-0.5"></i>'
              + '<span>' + escapeHtml(s.submitter_name || "Unknown") + '<br /><span class="text-xs text-slate-500">' + escapeHtml(s.submitter_email) + '</span></span>'
              + '</div>'
              + '</div>'

              + '<p class="text-xs text-slate-400 mt-4"><i class="fa-regular fa-calendar mr-1"></i>Submitted ' + formatDate(s.created_at) + '</p>'

              + actions
              + '</article>';
          }).join("");

          // Wire up action buttons
          container.querySelectorAll(".action-btn").forEach(function (btn) {
            btn.addEventListener("click", async function () {
              var id = btn.getAttribute("data-id");
              var action = btn.getAttribute("data-action");
              var verb = action === "approve" ? "approve and publish" : "reject";

              if (!confirm("Are you sure you want to " + verb + " this submission?")) return;

              btn.disabled = true;
              var original = btn.innerHTML;
              btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i>Processing...';

              try {
                var r = await fetch(API + "/api/admin/submissions/" + id + "/" + action, {
                  method: "POST",
                  credentials: "include",
                });
                var d = await r.json();
                if (!r.ok) throw new Error(d.error || "Failed");

                // Show success, then reload list
                btn.innerHTML = '<i class="fa-solid fa-check mr-1"></i>Done';
                setTimeout(function () {
                  loadSubmissions(currentStatus);
                }, 400);
              } catch (err) {
                alert("Error: " + err.message);
                btn.disabled = false;
                btn.innerHTML = original;
              }
            });
          });

        } catch (err) {
          container.innerHTML = '<div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center text-red-700">Error: ' + escapeHtml(err.message) + '</div>';
        }
      }

      // Tab clicks
      document.querySelectorAll(".status-tab").forEach(function (btn) {
        btn.addEventListener("click", function () {
          loadSubmissions(btn.getAttribute("data-status"));
        });
      });

      // Initial auth check
      fetch(API + "/api/auth/me", { credentials: "include" })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.user || d.user.role !== "admin") return show(unauthorized);
          show(adminPanel);
          loadSubmissions("pending");
        })
        .catch(function () { show(unauthorized); });
    })();
  </script>
</BaseLayout>