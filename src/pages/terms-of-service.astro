---
// src/pages/terms-of-service.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema, webPageSchema } from "../lib/schemas.js";

const title = "Terms of Service | DogCareFinder";
const description = "Terms and conditions for using DogCareFinder.";
const canonical = "https://dogcarefinder.com/terms-of-service/";

const schemas = [
  webPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: "Home", url: "https://dogcarefinder.com/" },
    { name: "Terms of Service", url: canonical },
  ]),
];

const lastUpdated = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <section class="bg-navy-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 text-center">
      <nav class="text-xs text-white/70 flex justify-center gap-2 mb-4">
        <a href="/" class="hover:text-white">Home</a>
        <i class="fa-solid fa-chevron-right text-[9px] self-center"></i>
        <span class="text-white font-semibold">Terms of Service</span>
      </nav>
      <h1 class="font-serif text-4xl md:text-5xl font-bold">Terms of Service</h1>
      <p class="mt-3 text-white/70 text-sm">Last updated: {lastUpdated}</p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14 prose prose-slate max-w-none">
    <p class="text-slate-700">By accessing DogCareFinder, you agree to these terms.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">1. Use of Service</h2>
    <p class="text-slate-700">DogCareFinder provides a directory of dog care providers. Information is provided "as-is" without warranty. You are responsible for verifying any provider before engaging services.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">2. Listings</h2>
    <p class="text-slate-700">Listings are provided by third parties. We do not endorse, guarantee, or verify every listing. Business owners are responsible for the accuracy of their information.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">3. Prohibited Use</h2>
    <ul class="list-disc pl-6 text-slate-700 space-y-1">
      <li>Scraping the site without permission.</li>
      <li>Submitting false or misleading information.</li>
      <li>Using the site for illegal activity.</li>
      <li>Attempting to disrupt or damage the site.</li>
    </ul>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">4. Intellectual Property</h2>
    <p class="text-slate-700">All content on this site (text, design, logos) is owned by DogCareFinder unless otherwise noted.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">5. Limitation of Liability</h2>
    <p class="text-slate-700">DogCareFinder is not liable for any damages arising from your use of the site or from services provided by listed businesses.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">6. Payments</h2>
    <p class="text-slate-700">Paid listings are billed per the plan you select. Refunds are provided at our discretion.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">7. Termination</h2>
    <p class="text-slate-700">We may remove any listing or suspend any account at our discretion, especially for violations of these terms.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">8. Changes to Terms</h2>
    <p class="text-slate-700">We may update these terms. Continued use means you accept the updated terms.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">9. Contact</h2>
    <p class="text-slate-700">Questions? Email <a href="mailto:info@dogcarefinder.com" class="text-forest-600 underline">info@dogcarefinder.com</a>.</p>
  </section>
</BaseLayout>