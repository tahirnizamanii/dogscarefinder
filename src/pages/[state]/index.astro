---
// src/pages/[state]/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchAllRecords, toUrlSegment, slugify } from "../../lib/database.js";
import {
  breadcrumbSchema,
  webPageSchema,
  itemListSchema,
  faqSchema,
} from "../../lib/schemas.js";
import { generateStateFaqs } from "../../lib/faqs.js";

export async function getStaticPaths() {
  const allListings = await fetchAllRecords();
  const stateMap = new Map();

  for (const listing of allListings) {
    if (!listing.state) continue;
    const stateSlug = toUrlSegment(listing.state);
    if (!stateMap.has(stateSlug)) {
      stateMap.set(stateSlug, listing.state);
    }
  }

  return Array.from(stateMap.entries()).map(([slug, display]) => ({
    params: { state: slug },
    props: { stateDisplay: display },
  }));
}

const { state: stateSlug } = Astro.params;
const { stateDisplay } = Astro.props;

// Fetch (cached — no extra API call)
const allListings = await fetchAllRecords();

// Filter this state's listings
const stateListings = allListings.filter(
  (l) => toUrlSegment(l.state) === stateSlug
);

// Aggregate unique cities
const cityMap = new Map();
for (const listing of stateListings) {
  if (!listing.city) continue;
  const citySlug = toUrlSegment(listing.city);
  if (!cityMap.has(citySlug)) {
    cityMap.set(citySlug, { display: listing.city, count: 0 });
  }
  cityMap.get(citySlug).count += 1;
}

const cities = Array.from(cityMap.entries())
  .map(([slug, data]) => ({ slug, ...data }))
  .sort((a, b) => a.display.localeCompare(b.display));

// Aggregate categories in this state
const categoryMap = new Map();
for (const listing of stateListings) {
  if (!listing.category) continue;
  const cat = listing.category;
  if (!categoryMap.has(cat)) {
    categoryMap.set(cat, { name: cat, slug: slugify(cat), count: 0 });
  }
  categoryMap.get(cat).count += 1;
}

const categories = Array.from(categoryMap.values()).sort((a, b) =>
  a.name.localeCompare(b.name)
);

const totalInState = stateListings.length;
const cityCount = cities.length;
const categoryCount = categories.length;

// ── SEO ─────────────────────────────────────────────────────────────────
const title = `Dog Care in ${stateDisplay} — ${totalInState} Providers Across ${cityCount} Cities | DogCareFinder`;
const description = `Find ${totalInState} verified dog groomers, trainers, boarding, vets & therapy providers in ${stateDisplay}. Browse by city and read reviews. 100% free.`;
const canonical = `https://dogcarefinder.com/${stateSlug}/`;

// ── FAQs ────────────────────────────────────────────────────────────────
const faqs = generateStateFaqs(
  stateDisplay,
  totalInState,
  cityCount,
  categoryCount
);

// ── Schemas (array — matches new layout) ────────────────────────────────
const schemas = [
  webPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: "Home", url: "https://dogcarefinder.com/" },
    { name: stateDisplay, url: canonical },
  ]),
  itemListSchema(
    `Dog Care Providers in ${stateDisplay}`,
    description,
    canonical,
    cities.map((c) => ({
      businessName: `Dog Care in ${c.display}`,
      city: c.display,
      state: stateDisplay,
      category: "Directory",
      phone: "",
      website: `https://dogcarefinder.com/${stateSlug}/${c.slug}/`,
      streetAddress: "",
      zipCode: "",
      rating: null,
      reviewCount: 0,
    })),
    "Directory"
  ),
  faqSchema(faqs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schemas={schemas}
>
  <!-- Breadcrumb -->
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="text-sm text-slate-500">
        <a href="/" class="hover:text-forest-600 transition">Home</a>
        <span class="mx-2">›</span>
        <span class="text-navy-900 font-medium">{stateDisplay}</span>
      </nav>
    </div>
  </div>

  <!-- Header -->
  <section class="bg-navy-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-white">
        Dog Care in {stateDisplay}
      </h1>
      <p class="mt-3 text-slate-300 max-w-2xl">
        Browse {totalInState} verified dog care providers across {cityCount} cities
        in {stateDisplay}. From groomers to veterinarians, find the right care
        for your dog.
      </p>
    </div>
  </section>

  <!-- Categories in this state -->
  {categories.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <h2 class="text-xl font-bold text-navy-900 mb-4">
        Services in {stateDisplay}
      </h2>
      <div class="flex flex-wrap gap-3">
        {categories.map((cat) => (
          <a
            href={`/${stateSlug}/#${cat.slug}`}
            class="inline-flex items-center gap-2 bg-white border border-slate-200 rounded-full px-4 py-2 text-sm font-medium text-slate-700 hover:border-forest-400 hover:text-forest-600 transition"
          >
            {cat.name}
            <span class="text-xs bg-slate-100 text-slate-500 rounded-full px-2 py-0.5">
              {cat.count}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- City grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-2xl font-bold text-navy-900 mb-6">
      Cities in {stateDisplay}
    </h2>

    {cities.length === 0 ? (
      <div class="bg-white rounded-xl border border-slate-200 p-8 text-center">
        <p class="text-slate-500">
          No cities with active listings yet. Check back soon.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {cities.map((city) => (
          <a
            href={`/${stateSlug}/${city.slug}/`}
            class="group bg-white rounded-xl border border-slate-200 p-5 hover:border-forest-400 hover:shadow-lg transition-all duration-200"
          >
            <div class="flex items-center justify-between">
              <h3 class="font-semibold text-navy-900 group-hover:text-forest-600 transition">
                {city.display}
              </h3>
              <span class="text-xs bg-forest-50 text-forest-600 rounded-full px-2.5 py-1 font-medium">
                {city.count} {city.count === 1 ? "provider" : "providers"}
              </span>
            </div>
            <p class="mt-2 text-sm text-slate-500">
              Dog grooming, training, boarding & more in {city.display}, {stateDisplay}.
            </p>
          </a>
        ))}
      </div>
    )}
  </section>

  <!-- FAQ -->
  {faqs.length > 0 && (
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
      <h2 class="text-2xl font-serif font-bold text-navy-900 mb-6">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="bg-white border border-slate-200 rounded-xl p-5 group">
            <summary class="font-semibold text-navy-900 cursor-pointer flex justify-between items-center">
              {faq.question}
              <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
            </summary>
            <p class="mt-3 text-slate-600 text-sm leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <!-- Back -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <a href="/" class="inline-flex items-center gap-2 text-forest-600 font-medium hover:text-forest-700 transition">
      ← Browse all states
    </a>
  </div>
</BaseLayout>