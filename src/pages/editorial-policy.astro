---
// src/pages/editorial-policy.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema, webPageSchema } from "../lib/schemas.js";

const title = "Editorial Policy | DogCareFinder";
const description = "How we create, review, and update content on DogCareFinder.";
const canonical = "https://dogcarefinder.com/editorial-policy/";

const schemas = [
  webPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: "Home", url: "https://dogcarefinder.com/" },
    { name: "Editorial Policy", url: canonical },
  ]),
];
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <section class="bg-navy-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 text-center">
      <nav class="text-xs text-white/70 flex justify-center gap-2 mb-4">
        <a href="/" class="hover:text-white">Home</a>
        <i class="fa-solid fa-chevron-right text-[9px] self-center"></i>
        <span class="text-white font-semibold">Editorial Policy</span>
      </nav>
      <h1 class="font-serif text-4xl md:text-5xl font-bold">Editorial Policy</h1>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14 prose prose-slate max-w-none">
    <h2 class="font-serif text-xl font-bold text-navy-900 mb-3">Our Commitment</h2>
    <p class="text-slate-700">DogCareFinder publishes practical guides for dog owners. We aim for accuracy, usefulness, and transparency — not volume for its own sake.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">Content Creation</h2>
    <ul class="list-disc pl-6 text-slate-700 space-y-1">
      <li>Guides are written to help real dog owners make real decisions.</li>
      <li>Some content is produced with the assistance of AI tools, then reviewed for accuracy and clarity.</li>
      <li>We do not publish AI-generated content without review.</li>
    </ul>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">Verification</h2>
    <p class="text-slate-700">Facts, pricing, and provider details are cross-checked against public sources before publication. If we can't verify something, we say so.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">Corrections</h2>
    <p class="text-slate-700">If you spot an error, email <a href="mailto:info@dogcarefinder.com" class="text-forest-600 underline">info@dogcarefinder.com</a>. We fix confirmed errors and note material corrections.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">Advertising & Sponsorship</h2>
    <p class="text-slate-700">Editorial content is not for sale. Sponsored content (if ever used) will be clearly labeled.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">Independence</h2>
    <p class="text-slate-700">We do not accept payment for positive reviews. Rankings are based on publicly available data (reviews, ratings, completeness of listing).</p>
  </section>
</BaseLayout>