---
// src/pages/dashboard.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema, webPageSchema } from "../lib/schemas.js";

const title = "Provider Dashboard | DogCareFinder";
const description = "Manage your DogCareFinder business listing.";
const canonical = "https://dogcarefinder.com/dashboard/";

const schemas = [
  webPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: "Home", url: "https://dogcarefinder.com/" },
    { name: "Dashboard", url: canonical },
  ]),
];
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="bg-white border border-slate-200 rounded-2xl p-10 text-center">
      <div class="w-16 h-16 mx-auto bg-gold-400/15 rounded-full flex items-center justify-center text-gold-500 text-3xl mb-5">
        <i class="fa-solid fa-tools"></i>
      </div>
      <h1 class="font-serif text-3xl font-bold text-navy-900 mb-3">Provider Dashboard Coming Soon</h1>
      <p class="text-slate-600 max-w-lg mx-auto mb-8">
        Once provider accounts launch, you'll be able to manage your listings, update business details,
        and track performance from a personalized dashboard.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/submit-listing/" class="inline-flex items-center gap-2 bg-forest-600 hover:bg-forest-700 text-white font-semibold px-6 py-3 rounded-lg transition">
          <i class="fa-solid fa-plus-circle"></i>
          Submit a Listing Now
        </a>
        <a href="/list-your-business/" class="inline-flex items-center gap-2 bg-white border border-slate-300 hover:border-slate-400 text-navy-900 font-semibold px-6 py-3 rounded-lg transition">
          <i class="fa-solid fa-tags"></i>
          View Plans
        </a>
      </div>
    </div>
  </section>
</BaseLayout>