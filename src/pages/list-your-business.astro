---
// src/pages/list-your-business.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema, webPageSchema, serviceSchema } from "../lib/schemas.js";

const title = `List Your Dog Care Business — Free Directory Listing | DogCareFinder`;
const description = `Join the largest canine services directory in the US. Free and paid listings available. Get found by dog owners searching your city and state.`;
const canonical = "https://dogcarefinder.com/list-your-business/";

const schemas = [
  webPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: "Home", url: "https://dogcarefinder.com/" },
    { name: "List Your Business", url: canonical },
  ]),
  serviceSchema(
    "Dog Care Business Listing",
    "Directory listing service for dog care businesses in the USA",
    canonical,
    { "@type": "Country", name: "United States" }
  ),
];
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>

  <!-- Hero -->
  <section class="bg-navy-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20 text-center">
      <nav class="text-xs text-white/70 flex justify-center items-center gap-2 mb-6">
        <a href="/" class="hover:text-white">Home</a>
        <i class="fa-solid fa-chevron-right text-[9px]"></i>
        <span class="text-white font-semibold">List Your Business</span>
      </nav>
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur rounded-full px-4 py-1.5 text-[10px] font-bold uppercase tracking-widest mb-6">
        <i class="fa-solid fa-store text-gold-400"></i>
        Dog Directory Listing
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight">
        List Your Business
      </h1>
      <p class="mt-4 text-base lg:text-lg text-white/80 max-w-2xl mx-auto">
        Join the fastest-growing directory of dog care professionals — now serving pet owners across the United States.
      </p>
    </div>
  </section>

  <!-- Info banner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
    <div class="bg-gold-400/15 border border-gold-400/40 rounded-xl p-5 flex items-start gap-3">
      <i class="fa-solid fa-circle-info text-gold-500 mt-0.5"></i>
      <p class="text-sm text-navy-900">
        <strong>You're not logged in.</strong> Sign up or log in to list your business.
      </p>
    </div>
  </section>

  <!-- Steps -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white border border-slate-200 rounded-2xl p-8">
        <div class="w-12 h-12 bg-forest-50 rounded-full flex items-center justify-center text-forest-600 text-xl mb-5">
          <i class="fa-solid fa-user-plus"></i>
        </div>
        <h3 class="font-serif text-lg font-bold text-navy-900 mb-2">1. Create your free account</h3>
        <p class="text-sm text-slate-600 leading-relaxed">
          Sign up in under 60 seconds. No credit card required.
        </p>
      </div>
      <div class="bg-white border border-slate-200 rounded-2xl p-8">
        <div class="w-12 h-12 bg-forest-50 rounded-full flex items-center justify-center text-forest-600 text-xl mb-5">
          <i class="fa-solid fa-pen-to-square"></i>
        </div>
        <h3 class="font-serif text-lg font-bold text-navy-900 mb-2">2. Add your business details</h3>
        <p class="text-sm text-slate-600 leading-relaxed">
          Name, address, category, services, hours, photos, and contact info.
        </p>
      </div>
      <div class="bg-white border border-slate-200 rounded-2xl p-8">
        <div class="w-12 h-12 bg-forest-50 rounded-full flex items-center justify-center text-forest-600 text-xl mb-5">
          <i class="fa-solid fa-rocket"></i>
        </div>
        <h3 class="font-serif text-lg font-bold text-navy-900 mb-2">3. Go live instantly</h3>
        <p class="text-sm text-slate-600 leading-relaxed">
          Your listing appears in our directory after a quick review.
        </p>
      </div>
    </div>
  </section>

  <!-- Plans -->
  <section class="bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-navy-900">
          Choose Your Plan
        </h2>
        <p class="mt-3 text-slate-600">
          Start free, upgrade anytime. No hidden fees, ever.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Basic -->
        <div class="bg-white border-2 border-slate-200 rounded-2xl p-6 flex flex-col">
          <div class="text-xs font-bold uppercase tracking-widest text-slate-500">Basic</div>
          <div class="mt-3 flex items-baseline gap-1">
            <span class="text-4xl font-serif font-bold text-navy-900">Free</span>
          </div>
          <div class="mt-1 text-xs text-slate-500">Listed forever</div>
          <ul class="mt-6 space-y-2 text-sm text-slate-600 flex-1">
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>One category</li>
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>Appears in search</li>
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>Contact info hidden</li>
            <li><i class="fa-solid fa-xmark text-slate-300 mr-2"></i>No photos</li>
          </ul>
          <button class="mt-6 w-full bg-slate-100 hover:bg-slate-200 text-navy-900 font-semibold py-3 rounded-lg transition">
            Get Started
          </button>
        </div>

        <!-- Monthly -->
        <div class="bg-white border-2 border-slate-200 rounded-2xl p-6 flex flex-col">
          <div class="text-xs font-bold uppercase tracking-widest text-slate-500">Monthly</div>
          <div class="mt-3 flex items-baseline gap-1">
            <span class="text-4xl font-serif font-bold text-navy-900">$19</span>
            <span class="text-sm text-slate-500">/mo</span>
          </div>
          <div class="mt-1 text-xs text-slate-500">Billed monthly</div>
          <ul class="mt-6 space-y-2 text-sm text-slate-600 flex-1">
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>Contact visible</li>
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>Verified badge</li>
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>Priority placement</li>
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>Up to 5 photos</li>
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>10% off Trio Assist</li>
          </ul>
          <button class="mt-6 w-full bg-forest-600 hover:bg-forest-700 text-white font-semibold py-3 rounded-lg transition">
            Choose Monthly
          </button>
        </div>

        <!-- Annual (featured) -->
        <div class="bg-white border-2 border-gold-400 rounded-2xl p-6 flex flex-col relative shadow-lg">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gold-400 text-navy-900 text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full">
            Most Popular
          </div>
          <div class="text-xs font-bold uppercase tracking-widest text-gold-600">Annual</div>
          <div class="mt-3 flex items-baseline gap-1">
            <span class="text-4xl font-serif font-bold text-navy-900">$149</span>
            <span class="text-sm text-slate-500">/yr</span>
          </div>
          <div class="mt-1 text-xs text-forest-700 font-semibold">Save 35%</div>
          <ul class="mt-6 space-y-2 text-sm text-slate-600 flex-1">
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>Everything in Monthly</li>
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>Priority support</li>
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>Up to 10 photos</li>
            <li><i class="fa-solid fa-check text-forest-600 mr-2"></i>15% off Trio Assist</li>
          </ul>
          <button class="mt-6 w-full bg-gold-400 hover:bg-gold-500 text-navy-900 font-bold py-3 rounded-lg transition">
            Choose Annual
          </button>
        </div>

        <!-- Lifetime -->
        <div class="bg-navy-900 text-white border-2 border-navy-900 rounded-2xl p-6 flex flex-col">
          <div class="text-xs font-bold uppercase tracking-widest text-gold-400">Lifetime</div>
          <div class="mt-3 flex items-baseline gap-1">
            <span class="text-4xl font-serif font-bold">$299</span>
          </div>
          <div class="mt-1 text-xs text-white/70">One-time payment</div>
          <ul class="mt-6 space-y-2 text-sm text-white/90 flex-1">
            <li><i class="fa-solid fa-check text-gold-400 mr-2"></i>Forever, no renewals</li>
            <li><i class="fa-solid fa-check text-gold-400 mr-2"></i>Unlimited photos</li>
            <li><i class="fa-solid fa-check text-gold-400 mr-2"></i>Featured placement</li>
            <li><i class="fa-solid fa-check text-gold-400 mr-2"></i>20% off Trio Assist</li>
          </ul>
          <button class="mt-6 w-full bg-gold-400 hover:bg-gold-500 text-navy-900 font-bold py-3 rounded-lg transition">
            Choose Lifetime
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="font-serif text-3xl font-bold text-navy-900 text-center mb-10">
      Frequently asked questions
    </h2>
    <div class="space-y-3">
      <details class="group bg-white border border-slate-200 rounded-xl">
        <summary class="cursor-pointer flex items-center justify-between gap-4 p-5 font-semibold text-navy-900">
          How long does approval take?
          <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="px-5 pb-5 text-sm text-slate-600">
          Most listings are reviewed within 24–48 hours.
        </div>
      </details>
      <details class="group bg-white border border-slate-200 rounded-xl">
        <summary class="cursor-pointer flex items-center justify-between gap-4 p-5 font-semibold text-navy-900">
          Can I update my listing later?
          <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="px-5 pb-5 text-sm text-slate-600">
          Yes — you can edit your listing anytime from your account dashboard.
        </div>
      </details>
      <details class="group bg-white border border-slate-200 rounded-xl">
        <summary class="cursor-pointer flex items-center justify-between gap-4 p-5 font-semibold text-navy-900">
          Do you charge referral fees or commissions?
          <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="px-5 pb-5 text-sm text-slate-600">
          Never. You only pay for your listing tier — no per-lead or per-booking fees.
        </div>
      </details>
      <details class="group bg-white border border-slate-200 rounded-xl">
        <summary class="cursor-pointer flex items-center justify-between gap-4 p-5 font-semibold text-navy-900">
          What categories can I list under?
          <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="px-5 pb-5 text-sm text-slate-600">
          Groomers, Trainers, Boarding, Vets, and Therapy. We're adding more categories regularly.
        </div>
      </details>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-forest-600">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 text-center">
      <h2 class="font-serif text-3xl font-bold text-white">Ready to grow your business?</h2>
      <p class="mt-3 text-white/80">
        List your dog care service today and get discovered by pet owners near you.
      </p>
      <a href="/" class="mt-6 inline-flex items-center gap-2 bg-white text-forest-700 font-bold px-8 py-3.5 rounded-lg hover:bg-forest-50 transition">
        <i class="fa-solid fa-plus-circle"></i>
        Create Your Listing
      </a>
    </div>
  </section>
</BaseLayout>