---
// src/pages/recommend-a-provider.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema, webPageSchema } from "../lib/schemas.js";

const title = "Recommend a Dog Care Provider | DogCareFinder";
const description = "Know a great dog care provider? Recommend them to our directory — we review every submission.";
const canonical = "https://dogcarefinder.com/recommend-a-provider/";

const schemas = [
  webPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: "Home", url: "https://dogcarefinder.com/" },
    { name: "Recommend a Provider", url: canonical },
  ]),
];
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <section class="bg-navy-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <nav class="text-xs text-white/70 flex justify-center gap-2 mb-4">
        <a href="/" class="hover:text-white">Home</a>
        <i class="fa-solid fa-chevron-right text-[9px] self-center"></i>
        <span class="text-white font-semibold">Recommend a Provider</span>
      </nav>
      <h1 class="font-serif text-4xl md:text-5xl font-bold">Recommend a Provider</h1>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto">
        Know a dog care professional who should be listed? Tell us — we review every recommendation.
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8">
      <form id="recommend-form" class="space-y-5">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">Your Name</label>
            <input type="text" name="your_name" required class="w-full px-4 py-3 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-forest-500" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">Your Email</label>
            <input type="email" name="your_email" required class="w-full px-4 py-3 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-forest-500" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">Business Name *</label>
          <input type="text" name="business_name" required class="w-full px-4 py-3 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-forest-500" />
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">City</label>
            <input type="text" name="city" class="w-full px-4 py-3 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-forest-500" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">State</label>
            <input type="text" name="state" maxlength="2" class="w-full px-4 py-3 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-forest-500 uppercase" placeholder="TX" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">Website or Phone</label>
          <input type="text" name="contact" class="w-full px-4 py-3 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-forest-500" placeholder="https://... or (555) 555-5555" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">Why do you recommend them?</label>
          <textarea name="reason" rows="5" class="w-full px-4 py-3 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-forest-500 resize-none"></textarea>
        </div>
        <div id="recommend-msg" class="hidden text-sm rounded-lg p-3"></div>
        <button type="submit" class="bg-forest-600 hover:bg-forest-700 text-white font-bold py-3 px-8 rounded-lg transition inline-flex items-center gap-2">
          <i class="fa-solid fa-paper-plane"></i> Submit Recommendation
        </button>
      </form>
    </div>
  </section>

  <script is:inline>
    document.getElementById("recommend-form")?.addEventListener("submit", function (e) {
      e.preventDefault();
      var msg = document.getElementById("recommend-msg");
      msg.className = "text-sm rounded-lg p-3 bg-forest-50 text-forest-800";
      msg.textContent = "Thanks! Your recommendation has been received. We review all submissions.";
      e.target.reset();
    });
  </script>
</BaseLayout>