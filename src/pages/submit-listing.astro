---
// src/pages/submit-listing.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema, webPageSchema, faqSchema } from "../lib/schemas.js";

const title = "Submit Your Dog Care Business — Free Directory Listing | DogCareFinder";
const description = "Add your dog grooming, training, boarding, or vet business to our nationwide directory. Free listing. Takes 2 minutes.";
const canonical = "https://dogcarefinder.com/submit-listing/";
const API = import.meta.env.PUBLIC_API_BASE_URL || "";

const faqs = [
  { question: "How long does it take?", answer: "About 2 minutes. We review and publish within 24-48 hours." },
  { question: "Is the listing free?", answer: "Yes. Basic listings are free forever. Upgrade anytime for extra visibility." },
  { question: "What information do I need?", answer: "Business name, category, address, phone number. Website is optional." },
  { question: "Can I edit later?", answer: "Yes — after submission, you can update your listing from your dashboard." },
];

const schemas = [
  webPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: "Home", url: "https://dogcarefinder.com/" },
    { name: "Submit Listing", url: canonical },
  ]),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <section class="bg-navy-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 text-center">
      <nav class="text-xs text-white/70 flex justify-center gap-2 mb-4">
        <a href="/" class="hover:text-white">Home</a>
        <i class="fa-solid fa-chevron-right text-[9px] self-center"></i>
        <span class="text-white font-semibold">Submit Listing</span>
      </nav>
      <div class="inline-flex items-center gap-2 bg-white/10 rounded-full px-4 py-1.5 text-[10px] font-bold uppercase tracking-widest mb-4">
        <i class="fa-solid fa-store text-gold-400"></i> Free Directory Listing
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold">Submit Your Business</h1>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto">
        Add your dog care business to our nationwide directory. Free listing — no referral fees, no commissions.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <div id="login-required" class="hidden mb-6 bg-gold-400/15 border border-gold-400/40 rounded-xl p-5">
          <div class="flex items-start gap-3">
            <i class="fa-solid fa-circle-info text-gold-500 mt-0.5"></i>
            <div class="flex-1">
              <p class="text-sm text-navy-900 font-semibold mb-2">Please log in to submit a listing</p>
              <div class="flex gap-2">
                <a href="/login/" class="bg-forest-600 hover:bg-forest-700 text-white text-xs font-bold px-4 py-2 rounded-lg transition">Log In</a>
                <a href="/signup/" class="bg-white border border-slate-300 hover:border-slate-400 text-navy-900 text-xs font-bold px-4 py-2 rounded-lg transition">Sign Up Free</a>
              </div>
            </div>
          </div>
        </div>

        <form id="listing-form" class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
          <div class="bg-forest-600 text-white px-6 py-4 flex items-center gap-3">
            <i class="fa-solid fa-pen-to-square text-lg"></i>
            <h2 class="font-bold text-base">Business Listing Form</h2>
          </div>
          <div class="p-6 sm:p-8 space-y-5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">Business Name *</label>
              <input type="text" name="businessName" required class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-forest-500 text-sm" placeholder="e.g. Happy Tails Grooming" />
            </div>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">Category *</label>
                <select name="category" required class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-forest-500 text-sm">
                  <option value="">Select category...</option>
                  <option value="Groomers">Dog Groomers</option>
                  <option value="Trainers">Dog Trainers</option>
                  <option value="Boarding">Dog Boarding</option>
                  <option value="Vets">Veterinarians</option>
                  <option value="Therapy">Therapy Dogs</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">State *</label>
                <input type="text" name="state" required maxlength="2" placeholder="TX" class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-forest-500 text-sm uppercase" />
              </div>
            </div>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">City *</label>
                <input type="text" name="city" required class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-forest-500 text-sm" />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">Zip Code</label>
                <input type="text" name="zipCode" class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-forest-500 text-sm" />
              </div>
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">Street Address</label>
              <input type="text" name="streetAddress" class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-forest-500 text-sm" />
            </div>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">Phone</label>
                <input type="tel" name="phone" class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-forest-500 text-sm" placeholder="(512) 555-0100" />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-navy-900 mb-2">Website</label>
                <input type="url" name="website" class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-forest-500 text-sm" placeholder="https://..." />
              </div>
            </div>
            <div id="form-message" class="hidden text-sm rounded-lg p-3"></div>
            <button type="submit" id="submit-btn" class="w-full bg-forest-600 hover:bg-forest-700 text-white font-bold py-3.5 rounded-lg transition shadow-sm flex items-center justify-center gap-2">
              <i class="fa-solid fa-paper-plane"></i>
              Submit Listing
            </button>
          </div>
        </form>
      </div>

      <aside class="space-y-5">
        <div class="bg-white border border-slate-200 rounded-xl p-5">
          <h3 class="font-bold text-navy-900 text-sm mb-4 flex items-center gap-2">
            <i class="fa-solid fa-list-check text-forest-600"></i>
            What You'll Need
          </h3>
          <ul class="space-y-2.5 text-sm text-slate-600">
            <li class="flex items-start gap-2"><i class="fa-solid fa-check text-forest-600 mt-1 text-xs"></i><span>Business name</span></li>
            <li class="flex items-start gap-2"><i class="fa-solid fa-check text-forest-600 mt-1 text-xs"></i><span>Category</span></li>
            <li class="flex items-start gap-2"><i class="fa-solid fa-check text-forest-600 mt-1 text-xs"></i><span>Address, city, state</span></li>
            <li class="flex items-start gap-2"><i class="fa-solid fa-check text-forest-600 mt-1 text-xs"></i><span>Phone number</span></li>
            <li class="flex items-start gap-2"><i class="fa-solid fa-check text-forest-600 mt-1 text-xs"></i><span>Website (optional)</span></li>
          </ul>
        </div>
        <div class="bg-forest-50 border border-forest-200 rounded-xl p-5">
          <h3 class="font-bold text-forest-800 text-sm mb-2 flex items-center gap-2">
            <i class="fa-solid fa-clock"></i> Review Time
          </h3>
          <p class="text-sm text-slate-700 leading-relaxed">Most listings are reviewed within <strong>24-48 hours</strong>.</p>
        </div>
        <div class="bg-navy-900 text-white rounded-xl p-5">
          <h3 class="font-bold text-sm mb-3 flex items-center gap-2">
            <i class="fa-solid fa-headset text-gold-400"></i> Need Help?
          </h3>
          <p class="text-sm text-white/80 mb-3">Questions?</p>
          <a href="mailto:info@dogcarefinder.com" class="inline-flex items-center gap-2 text-gold-400 font-semibold text-sm">
            <i class="fa-solid fa-envelope"></i> info@dogcarefinder.com
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <h2 class="font-serif text-2xl font-bold text-navy-900 text-center mb-8">Common questions</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="group bg-white border border-slate-200 rounded-xl">
          <summary class="cursor-pointer flex items-center justify-between gap-4 p-5 font-semibold text-navy-900">
            {faq.question}
            <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
          </summary>
          <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed">{faq.answer}</div>
        </details>
      ))}
    </div>
  </section>

  <script is:inline define:vars={{ API }}>
    (function () {
      var form = document.getElementById("listing-form");
      var msg = document.getElementById("form-message");
      var btn = document.getElementById("submit-btn");
      var loginRequired = document.getElementById("login-required");

      fetch(API + "/api/auth/me", { credentials: "include" })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.user) loginRequired.classList.remove("hidden");
        })
        .catch(function () {});

      form.addEventListener("submit", async function (e) {
        e.preventDefault();
        msg.className = "hidden";
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';

        var formData = new FormData(form);
        var payload = {};
        formData.forEach(function (v, k) { payload[k] = String(v).trim(); });

        try {
          var res = await fetch(API + "/api/listings/submit", {
            method: "POST",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          var data = await res.json();

          if (res.ok && data.success) {
            msg.className = "text-sm rounded-lg p-3 bg-forest-50 text-forest-800";
            msg.textContent = data.message || "Submission received!";
            form.reset();
            setTimeout(function () { window.location.href = "/dashboard/"; }, 1500);
          } else if (res.status === 401) {
            msg.className = "text-sm rounded-lg p-3 bg-gold-400/20 text-navy-900";
            msg.innerHTML = 'You need to be logged in. <a href="/login/" class="text-forest-700 font-semibold underline">Log in</a> or <a href="/signup/" class="text-forest-700 font-semibold underline">Sign up</a>.';
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Submit Listing';
          } else {
            msg.className = "text-sm rounded-lg p-3 bg-red-50 text-red-700";
            msg.textContent = data.error || "Submission failed";
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Submit Listing';
          }
        } catch (err) {
          msg.className = "text-sm rounded-lg p-3 bg-red-50 text-red-700";
          msg.textContent = "Network error. Please try again.";
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Submit Listing';
        }
      });
    })();
  </script>
</BaseLayout>