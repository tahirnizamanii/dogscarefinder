---
// src/pages/privacy-policy.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema, webPageSchema } from "../lib/schemas.js";

const title = "Privacy Policy | DogCareFinder";
const description = "How DogCareFinder collects, uses, and protects your personal information.";
const canonical = "https://dogcarefinder.com/privacy-policy/";

const schemas = [
  webPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: "Home", url: "https://dogcarefinder.com/" },
    { name: "Privacy Policy", url: canonical },
  ]),
];

const lastUpdated = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <section class="bg-navy-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 text-center">
      <nav class="text-xs text-white/70 flex justify-center gap-2 mb-4">
        <a href="/" class="hover:text-white">Home</a>
        <i class="fa-solid fa-chevron-right text-[9px] self-center"></i>
        <span class="text-white font-semibold">Privacy Policy</span>
      </nav>
      <h1 class="font-serif text-4xl md:text-5xl font-bold">Privacy Policy</h1>
      <p class="mt-3 text-white/70 text-sm">Last updated: {lastUpdated}</p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14 prose prose-slate max-w-none">
    <p class="text-slate-700 leading-relaxed">DogCareFinder ("we", "our", "us") respects your privacy. This policy explains what information we collect, how we use it, and your rights.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">1. Information We Collect</h2>
    <ul class="list-disc pl-6 text-slate-700 space-y-1">
      <li><strong>Contact information</strong> you submit — name, email, subject, message.</li>
      <li><strong>Business information</strong> submitted through listing forms.</li>
      <li><strong>Usage data</strong> — pages visited, referral source, device type.</li>
      <li><strong>Cookies</strong> for basic site functionality and analytics.</li>
    </ul>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">2. How We Use Information</h2>
    <ul class="list-disc pl-6 text-slate-700 space-y-1">
      <li>Respond to inquiries.</li>
      <li>Display business listings.</li>
      <li>Improve site content and user experience.</li>
      <li>Send optional updates if you subscribe.</li>
    </ul>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">3. Cookies</h2>
    <p class="text-slate-700">We use cookies for analytics and session functionality. You can disable cookies in your browser at any time.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">4. Third Parties</h2>
    <p class="text-slate-700">We may use third-party services (analytics, hosting). These providers have their own privacy policies.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">5. Your Rights</h2>
    <p class="text-slate-700">You may request access, correction, or deletion of your personal data by emailing <a href="mailto:info@dogcarefinder.com" class="text-forest-600 underline">info@dogcarefinder.com</a>.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">6. Data Security</h2>
    <p class="text-slate-700">We use industry-standard safeguards. No online system is 100% secure, and we cannot guarantee absolute security.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">7. Children's Privacy</h2>
    <p class="text-slate-700">Our services are not directed to children under 13. We do not knowingly collect data from children.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">8. Changes</h2>
    <p class="text-slate-700">We may update this policy. Continued use of the site means you accept the current version.</p>

    <h2 class="font-serif text-xl font-bold text-navy-900 mt-8 mb-3">9. Contact</h2>
    <p class="text-slate-700">Questions? <a href="mailto:info@dogcarefinder.com" class="text-forest-600 underline">Email us</a> or visit <a href="/contact/" class="text-forest-600 underline">/contact/</a>.</p>
  </section>
</BaseLayout>