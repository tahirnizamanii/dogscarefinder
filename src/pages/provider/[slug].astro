---
// src/pages/provider/[slug].astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  fetchAllRecords,
  toUrlSegment,
  slugify,
  renderStars,
  truncate,
} from "../../lib/database.js";
import {
  breadcrumbSchema,
  webPageSchema,
  localBusinessSchema,
  faqSchema,
} from "../../lib/schemas.js";

export async function getStaticPaths() {
  const listings = await fetchAllRecords();
  // Deduplicate slugs
  const seen = new Set();
  const paths = [];
  for (const l of listings) {
    if (seen.has(l.slug)) continue;
    seen.add(l.slug);
    paths.push({
      params: { slug: l.slug },
      props: { provider: l },
    });
  }
  return paths;
}

const { provider } = Astro.props;
const allListings = await fetchAllRecords();

// Find similar providers (same category, same city, excluding current)
const similar = allListings
  .filter(
    (l) =>
      l.category === provider.category &&
      l.city === provider.city &&
      l.id !== provider.id
  )
  .slice(0, 4);

// FAQs specific to this provider
const faqs = [
  {
    question: `Does ${provider.businessName} serve ${provider.city}, ${provider.state}?`,
    answer: `Yes — ${provider.businessName} is located in ${provider.city}, ${provider.state}${provider.streetAddress ? ` at ${provider.streetAddress}` : ""}. They provide ${provider.category.toLowerCase()} services to the local area.`,
  },
  {
    question: `How do I contact ${provider.businessName}?`,
    answer: provider.phone
      ? `You can call ${provider.businessName} directly at ${provider.phone}${provider.website ? ` or visit their website at ${provider.website}` : ""}. We recommend calling ahead to confirm availability and pricing.`
      : `Visit ${provider.businessName} in person at ${provider.streetAddress || "their listed location"} in ${provider.city}, ${provider.state}.`,
  },
  {
    question: `What is ${provider.businessName}'s rating?`,
    answer:
      provider.rating !== null && provider.reviewCount > 0
        ? `${provider.businessName} has an average rating of ${provider.rating} out of 5 stars, based on ${provider.reviewCount} verified customer reviews.`
        : `${provider.businessName} is a listed ${provider.category.toLowerCase()} provider in our directory. Ratings will appear once customer reviews are collected.`,
  },
  {
    question: `Are there other ${provider.category.toLowerCase()} in ${provider.city}?`,
    answer: `Yes — our directory lists multiple ${provider.category.toLowerCase()} in ${provider.city}, ${provider.state}. Browse our category page to compare all options side by side.`,
  },
];

// SEO
const title = `${provider.businessName} — ${provider.category} in ${provider.city}, ${provider.state} | DogCareFinder`;
const description = truncate(
  provider.description ||
    `${provider.businessName} is a verified ${provider.category.toLowerCase()} provider in ${provider.city}, ${provider.state}. See contact info, ratings, and reviews.`,
  158
);
const canonical = `https://dogcarefinder.com/provider/${provider.slug}/`;

const schemas = [
  webPageSchema(title, description, canonical),
  breadcrumbSchema([
    { name: "Home", url: "https://dogcarefinder.com/" },
    { name: provider.state, url: `https://dogcarefinder.com/${toUrlSegment(provider.state)}/` },
    { name: provider.city, url: `https://dogcarefinder.com/${toUrlSegment(provider.state)}/${toUrlSegment(provider.city)}/` },
    { name: provider.category, url: `https://dogcarefinder.com/${toUrlSegment(provider.state)}/${toUrlSegment(provider.city)}/${slugify(provider.category)}/` },
    { name: provider.businessName, url: canonical },
  ]),
  localBusinessSchema(provider, provider.category),
  faqSchema(faqs),
];

// Map URL (Google Maps embed)
const mapQuery = encodeURIComponent(
  `${provider.streetAddress || ""}, ${provider.city}, ${provider.state} ${provider.zipCode || ""}`.trim()
);
const mapEmbedUrl = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>

  <!-- Breadcrumb -->
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="text-sm text-slate-500 flex flex-wrap items-center gap-1">
        <a href="/" class="hover:text-forest-600">Home</a>
        <span class="mx-1">›</span>
        <a href={`/${toUrlSegment(provider.state)}/`} class="hover:text-forest-600">{provider.state}</a>
        <span class="mx-1">›</span>
        <a href={`/${toUrlSegment(provider.state)}/${toUrlSegment(provider.city)}/`} class="hover:text-forest-600">{provider.city}</a>
        <span class="mx-1">›</span>
        <a href={`/${toUrlSegment(provider.state)}/${toUrlSegment(provider.city)}/${slugify(provider.category)}/`} class="hover:text-forest-600">{provider.category}</a>
        <span class="mx-1">›</span>
        <span class="text-navy-900 font-medium">{provider.businessName}</span>
      </nav>
    </div>
  </div>

  <!-- HERO -->
  <section class="bg-navy-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid lg:grid-cols-3 gap-8 items-start">
        <div class="lg:col-span-2">
          <div class="inline-flex items-center gap-2 bg-white/10 rounded-full px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest text-white/90 mb-4">
            <i class="fa-solid fa-store text-gold-400"></i>
            Verified {provider.category}
          </div>
          <h1 class="font-serif text-3xl md:text-4xl lg:text-5xl font-bold leading-tight">
            {provider.businessName}
          </h1>
          <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-white/80">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-location-dot text-gold-400"></i>
              <span>{provider.city}, {provider.state} {provider.zipCode}</span>
            </div>
            {provider.rating !== null && (
              <div class="flex items-center gap-2">
                <span class="text-amber-400">{renderStars(provider.rating)}</span>
                <span class="font-bold text-white">{provider.rating.toFixed(1)}</span>
                <span class="text-white/60">({provider.reviewCount} reviews)</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid lg:grid-cols-3 gap-8">

      <!-- LEFT -->
      <div class="lg:col-span-2 space-y-8">

        <!-- About -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8">
          <h2 class="font-serif text-2xl font-bold text-navy-900 mb-4">About {provider.businessName}</h2>
          {provider.description ? (
            <div class="text-slate-700 leading-relaxed text-base" set:html={provider.description}></div>
          ) : (
            <p class="text-slate-600 leading-relaxed">
              {provider.businessName} is a trusted {provider.category.toLowerCase()} provider serving {provider.city}, {provider.state} and the surrounding area. Contact them directly for availability, pricing, and services offered.
            </p>
          )}
        </div>

        <!-- Map -->
        {provider.streetAddress && (
          <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
            <div class="p-6 sm:p-8 pb-4">
              <h2 class="font-serif text-2xl font-bold text-navy-900 mb-2">Location</h2>
              <p class="text-sm text-slate-600 flex items-center gap-2">
                <i class="fa-solid fa-map-pin text-forest-600"></i>
                {provider.streetAddress}, {provider.city}, {provider.state} {provider.zipCode}
              </p>
            </div>
            <iframe
              src={mapEmbedUrl}
              width="100%"
              height="320"
              style="border:0; display:block;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Map of ${provider.businessName}`}
            ></iframe>
          </div>
        )}

        <!-- FAQ -->
        {faqs.length > 0 && (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8">
            <h2 class="font-serif text-2xl font-bold text-navy-900 mb-6">Frequently Asked Questions</h2>
            <div class="space-y-3">
              {faqs.map((faq) => (
                <details class="group bg-slate-50 border border-slate-200 rounded-xl">
                  <summary class="cursor-pointer flex items-center justify-between gap-4 p-5 font-semibold text-navy-900">
                    <span class="text-sm">{faq.question}</span>
                    <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform text-xs shrink-0"></i>
                  </summary>
                  <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed">{faq.answer}</div>
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- Similar providers -->
        {similar.length > 0 && (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8">
            <h2 class="font-serif text-xl font-bold text-navy-900 mb-4">
              Other {provider.category} in {provider.city}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {similar.map((s) => (
                <a href={`/provider/${s.slug}/`} class="group bg-slate-50 border border-slate-200 rounded-xl p-4 hover:border-forest-400 transition">
                  <div class="font-semibold text-navy-900 text-sm group-hover:text-forest-600 transition">{s.businessName}</div>
                  <div class="mt-1 flex items-center gap-2 text-xs text-slate-500">
                    {s.rating !== null && (
                      <>
                        <span class="text-amber-500"><i class="fa-solid fa-star"></i> {s.rating.toFixed(1)}</span>
                        <span>·</span>
                      </>
                    )}
                    <span>{s.reviewCount} reviews</span>
                  </div>
                </a>
              ))}
            </div>
            <div class="mt-4 pt-4 border-t border-slate-100">
              <a href={`/${toUrlSegment(provider.state)}/${toUrlSegment(provider.city)}/${slugify(provider.category)}/`} class="text-sm font-semibold text-forest-600 hover:text-forest-700 inline-flex items-center gap-2">
                View all {provider.category.toLowerCase()} in {provider.city}
                <i class="fa-solid fa-arrow-right text-xs"></i>
              </a>
            </div>
          </div>
        )}
      </div>

      <!-- SIDEBAR -->
      <aside class="space-y-6">
        <!-- Contact card -->
        <div class="bg-white rounded-2xl border-2 border-forest-500/30 p-6 sticky top-24">
          <h3 class="font-bold text-navy-900 text-lg mb-4 flex items-center gap-2">
            <i class="fa-solid fa-address-card text-forest-600"></i>
            Contact Info
          </h3>

          {provider.phone && (
            <a href={`tel:${provider.phone}`} class="w-full inline-flex items-center justify-center gap-2 bg-forest-600 hover:bg-forest-700 text-white font-semibold py-3 px-4 rounded-lg transition mb-2">
              <i class="fa-solid fa-phone"></i>
              Call {provider.phone}
            </a>
          )}

          {provider.website && (
            <a href={provider.website} target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 text-navy-900 font-semibold py-3 px-4 rounded-lg transition mb-2">
              <i class="fa-solid fa-globe"></i>
              Visit Website
            </a>
          )}

          {provider.streetAddress && (
            <a href={mapEmbedUrl.replace("&output=embed", "")} target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center gap-2 border border-slate-300 hover:border-slate-400 text-navy-900 font-semibold py-3 px-4 rounded-lg transition">
              <i class="fa-solid fa-diamond-turn-right"></i>
              Get Directions
            </a>
          )}

          <div class="mt-5 pt-5 border-t border-slate-100 space-y-3 text-sm">
            <div class="flex items-start gap-2 text-slate-600">
              <i class="fa-solid fa-location-dot text-forest-600 w-4 mt-0.5"></i>
              <span>
                {provider.streetAddress && <>{provider.streetAddress}<br /></>}
                {provider.city}, {provider.state} {provider.zipCode}
              </span>
            </div>
            <div class="flex items-center gap-2 text-slate-600">
              <i class="fa-solid fa-tag text-forest-600 w-4"></i>
              <span>{provider.category}</span>
            </div>
          </div>
        </div>

        <!-- Report -->
        <div class="bg-cream-100 border border-slate-200 rounded-xl p-4 text-xs text-slate-600">
          <div class="flex items-start gap-2">
            <i class="fa-solid fa-circle-info text-forest-600 mt-0.5"></i>
            <p>
              Is this your business or did you spot an error?
              <a href="/contact/" class="text-forest-600 font-semibold underline">Let us know</a>.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>